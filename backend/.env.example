# ---------- Server ----------
PORT=4000
# The Next.js frontend (allowed for CORS, cookies and redirects)
APP_URL=http://localhost:3000
# This API's public address (used to build OAuth callback URLs)
API_URL=http://localhost:4000
# Local clone of the private hidden-tests repo (relative to the backend folder, or absolute)
TESTS_DIR=../../repo-forge-tests

# ---------- Database ----------
DATABASE_URL=postgresql://capstone_user:capstone123@localhost:5432/capstone_db

# ---------- Login ----------
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Only needed in the cloud when frontend and API are on sub-domains, e.g. .repoforge.dev
# COOKIE_DOMAIN=

# Google OAuth client (redirect URI: <API_URL>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth app (callback URL: <API_URL>/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Magic-link emails ----------
# brevo = real email, mailpit = local test inbox (http://localhost:8025), console = print the link
MAIL_PROVIDER=console
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=RepoForge
BREVO_API_KEY=
MAILPIT_URL=http://localhost:8025
