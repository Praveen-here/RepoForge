{
  "name": "repo-forge-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Repo Forge API: sessions, files, terminal and grading for repo-level challenges",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "db:setup": "npm run migrate && npm run seed",
    "validate-problem": "node --env-file-if-exists=.env scripts/validate-problem.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "tar-stream": "^3.2.1",
    "ws": "^8.22.0"
  }
}
